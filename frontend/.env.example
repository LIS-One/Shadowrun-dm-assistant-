# Where the Spring Boot API runs (server-side only, never exposed to the browser)
BACKEND_URL=http://localhost:8080

# --- Auth0 (Regular Web Application) ---
AUTH_MODE=auth0
AUTH0_DOMAIN=my-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
AUTH0_AUDIENCE=https://dm-assistant/api
APP_BASE_URL=http://localhost:3000

# --- or local dev login (backend must run with DEV_AUTH_ENABLED=true and the same secret) ---
# AUTH_MODE=dev
# DEV_AUTH_SECRET=change-me-to-a-long-random-string-32+chars
