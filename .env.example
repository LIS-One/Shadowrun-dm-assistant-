# ---- Auth0 (production) ----
# Tenant domain, e.g. my-tenant.eu.auth0.com
AUTH0_DOMAIN=
# Same tenant as an issuer URL with trailing slash: https://my-tenant.eu.auth0.com/
AUTH0_ISSUER=
# Identifier of the API you created in Auth0 → Applications → APIs
AUTH0_AUDIENCE=https://dm-assistant/api
# Regular Web Application credentials
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret for the session cookie: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# ---- Local dev login instead of Auth0 (never on a public server) ----
# AUTH_MODE=dev
# DEV_AUTH_ENABLED=true
# DEV_AUTH_SECRET=change-me-to-a-long-random-string-32+chars

DB_PASSWORD=dm_assistant
