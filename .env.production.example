# Copy to .env on the server:  cp .env.production.example .env
# Then fill in every value. Never commit .env — it contains secrets.

# Lets you type plain "docker compose ..." instead of "docker compose -f docker-compose.prod.yml ...".
# If ports 80/443 are taken by your own nginx, use instead:
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.behind-proxy.yml
COMPOSE_FILE=docker-compose.prod.yml

# The address players will open (without https://), e.g. dm.example.com
DOMAIN=

# Database password: any long random string, e.g. the output of: openssl rand -hex 24
# The database keeps the password from its first start, so do not change it later.
DB_PASSWORD=

# ---- Auth0 ----
# Domain of your Auth0 tenant, without https://, e.g. shadowrun-dm.eu.auth0.com
AUTH0_DOMAIN=
# Identifier of the API you created in Auth0 (Applications → APIs)
AUTH0_AUDIENCE=https://dm-assistant/api
# Regular Web Application → Settings → Basic Information
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Session cookie encryption key: the output of  openssl rand -hex 32
AUTH0_SECRET=
